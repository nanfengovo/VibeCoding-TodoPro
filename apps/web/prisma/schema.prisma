// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Goal {
  id          String    @id @default(uuid())
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  projects    Project[]
  tasks       Task[]
  userId      String    // Ties to Supabase auth.users.id
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id          String    @id @default(uuid())
  title       String
  description String?
  goalId      String?
  goal        Goal?     @relation(fields: [goalId], references: [id])
  tasks       Task[]
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  goalId      String?
  goal        Goal?     @relation(fields: [goalId], references: [id])
  startTime   DateTime?
  endTime     DateTime?
  status      String    @default("TODO") // TODO, IN_PROGRESS, COMPLETED
  priority    Int       @default(0)
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Knowledge {
  id          String    @id @default(uuid())
  title       String
  content     String
  source      String?
  tags        String[]
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model DailyLog {
  id          String    @id @default(uuid())
  date        DateTime  @db.Date
  completed   String?
  notes       String?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([date, userId])
}
